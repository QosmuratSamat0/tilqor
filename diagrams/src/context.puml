@startuml context
' System context diagram (TIL-6).
' Actors follow docs/requirements.md, section 2 (TIL-11).
title Tilqor - system context

left to right direction
skinparam shadowing false
skinparam rectangle {
  BackgroundColor<<system>> #DDEBF7
  BorderColor<<system>> #2F5597
  BackgroundColor<<external>> #EEEEEE
  BorderColor<<external>> #7F7F7F
}

actor "Visitor" as visitor
actor "Participant" as participant
actor "Reviewer" as reviewer
actor "Moderator / admin" as moderator
actor "NLP researcher\n(dataset user)" as researcher

rectangle "Tilqor\n\nCrowdsourcing platform for collecting\nand verifying Kazakh language data" <<system>> as tilqor

rectangle "Sentence sources\n(e.g. Tatoeba, OPUS;\nlicence to be checked)" <<external>> as sources
rectangle "AI service for near-duplicate\nsuggestions (optional, FR-23)" <<external>> as ai

visitor --> tilqor : browses dictionary\nand daily catalogue
participant --> tilqor : submits translations\nand term variants
reviewer --> tilqor : reviews contributions,\nanswers control tasks
moderator --> tilqor : resolves disputes, manages tasks,\nroles and quality settings
researcher --> tilqor : downloads accepted data\n(CSV / JSON)

tilqor --> sources : imports Russian source sentences\nwith licence and attribution (FR-06)
tilqor ..> ai : similarity check\n(can be disabled)
@enduml

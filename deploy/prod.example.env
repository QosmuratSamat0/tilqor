# Production configuration. On the server: cp deploy/prod.example.env .env, then replace every change-me.
# NEVER commit the real .env file.

# Public address. Without your own domain use <static-ip>.sslip.io, e.g. 3.120.45.67.sslip.io
SITE_ADDRESS=change-me.sslip.io

# Django
# Generate the key with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=change-me.sslip.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://change-me.sslip.io
# Caddy terminates HTTPS and sends X-Forwarded-Proto; trust it only behind Caddy.
DJANGO_SECURE_PROXY=true
DJANGO_SECURE_HSTS_SECONDS=86400

# gunicorn processes: 2 for 1 GB RAM (t3.micro), 3-4 for 2-4 GB
GUNICORN_WORKERS=2

# PostgreSQL (the backend container connects to the "db" service)
POSTGRES_DB=tilqor
POSTGRES_USER=tilqor
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

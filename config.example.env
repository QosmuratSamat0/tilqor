# Example configuration. Copy to .env and fill in real values locally.
# NEVER commit the real .env file.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (used by docker compose and by the backend)
POSTGRES_DB=tilqor
POSTGRES_USER=tilqor
POSTGRES_PASSWORD=change-me
# localhost when running Django or pytest on your machine;
# docker compose sets it to "db" for the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
